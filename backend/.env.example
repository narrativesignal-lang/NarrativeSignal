ENV=dev
# Production / Docker Compose defaults (compose also injects DATABASE_URL + REDIS_URL for backend services).
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/narrative
REDIS_URL=redis://redis:6379/0
# Local-only manual override (host uvicorn + published DB port): set DATABASE_URL/REDIS_URL in a non-committed .env — do not commit host-specific URLs as defaults.

# Browser CORS when the SPA origin differs from the API (comma-separated). Docker Compose sets this for dev.
# CORS_ALLOW_ORIGINS=http://127.0.0.1:3000

# JWT
JWT_SECRET=change-me
JWT_ISSUER=narrative-platform

# Optional: when non-empty, only these accounts (users.is_admin must still be true) pass /api/admin/* and see is_admin on /me.
# ADMIN_USERNAMES=admin
# ADMIN_EMAILS=admin@internal.test
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI providers (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
# Use a model id valid for generativelanguage REST :generateContent (legacy names are remapped in code).
GEMINI_MODEL=gemini-2.0-flash

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Scheduler defaults
DEFAULT_MONITORING_CRON=*/60 * * * *

# Twelve Data — optional: entity market search / quotes / OHLCV via GET /api/market/*
TWELVE_API_KEY=

# Massive: supplemental market data only (background repair + backfill queue). Hard quotas: MASSIVE_QUOTA_*.
MASSIVE_API_KEY=
# MASSIVE_QUOTA_PER_MINUTE=30
# MASSIVE_QUOTA_PER_DAY=2000

# OpenAI (optional): chart-window AI explanations (POST /api/ai/*). Not Massive.
# OPENAI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions

# GET /api/portfolios/instruments/search: call Twelve when local match count is below this (default 1 = empty only)
# INSTRUMENT_SEARCH_MIN_LOCAL_BEFORE_EXTERNAL=3

# Yahoo/yfinance last-resort fallback: spacing and 429 cooldown (effective pause is max(600, this value) seconds)
# YAHOO_FALLBACK_MIN_INTERVAL_SECONDS=1.25
# YAHOO_RATE_LIMIT_COOLDOWN_SECONDS=600

# Google Trends (pytrends) — optional proxy if rate-limited / geo-blocked
TRENDS_PROXY_URL=
TRENDS_DEFAULT_TIMEFRAME=today 6-m
TRENDS_REQUEST_SLEEP_SECONDS=1.5

