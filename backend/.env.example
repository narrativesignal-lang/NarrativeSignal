ENV=dev
# Docker Compose: use hostname `postgres` / `redis` (compose overrides these in docker-compose.yml).
# Running uvicorn on the host with Compose Postgres mapped to localhost:5432: use @localhost:5432 instead.
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/narrative
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me
JWT_ISSUER=narrative-platform

# Optional: when non-empty, only these accounts (users.is_admin must still be true) pass /api/admin/* and see is_admin on /me.
# ADMIN_USERNAMES=admin
# ADMIN_EMAILS=admin@internal.test
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI providers (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Scheduler defaults
DEFAULT_MONITORING_CRON=*/60 * * * *

# Google Trends (pytrends) — optional proxy if rate-limited / geo-blocked
TRENDS_PROXY_URL=
TRENDS_DEFAULT_TIMEFRAME=today 6-m
TRENDS_REQUEST_SLEEP_SECONDS=1.5

